NODE_ENV=production
PORT=4000
APP_URL=https://api.zord.tech/sprintview
FRONTEND_URL=https://sprintview.zord.tech
FRONTEND_URLS=https://sprintview.zord.tech,http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=1
MONGO_URI=mongodb://localhost:27017/sprintview
MONGODB_URI=mongodb://localhost:27017/sprintview
MONGODB_SCHEME=mongodb
MONGODB_HOST=mongodb-env-rci1gjq2hx.ap-south-1a.lb.nimbuz.tech
MONGODB_PORT=30090
MONGODB_DATABASE=sprintview
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=
JWT_ACCESS_SECRET=replace-with-long-secret
JWT_REFRESH_SECRET=replace-with-long-secret
ENCRYPTION_SECRET=replace-with-32-char-secret
COOKIE_SECURE=true
COOKIE_DOMAIN=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.zord.tech/sprintview/api/v1/auth/oauth/google/callback
GOOGLE_SCOPES=openid email profile

ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=https://api.zord.tech/sprintview/api/v1/jira/callback
ATLASSIAN_SCOPES=read:jira-work read:jira-user
ATLASSIAN_AUTH_REDIRECT_URI=https://api.zord.tech/sprintview/api/v1/auth/oauth/atlassian/callback
ATLASSIAN_AUTH_SCOPES=read:me

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

REDIS_URL=
RUN_INLINE_JOBS=true

PUPPETEER_EXECUTABLE_PATH=
