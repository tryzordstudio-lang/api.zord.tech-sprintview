NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=false
MONGODB_URI=
MONGODB_SCHEME=mongodb
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=sprintview
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=
JWT_ACCESS_SECRET=replace-with-long-secret
JWT_REFRESH_SECRET=replace-with-long-secret
ENCRYPTION_SECRET=replace-with-32-char-secret
COOKIE_SECURE=false
COOKIE_DOMAIN=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/google/callback
GOOGLE_SCOPES=openid email profile

ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/atlassian/callback
ATLASSIAN_SCOPES=read:jira-work read:jira-user
ATLASSIAN_AUTH_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/atlassian/callback
ATLASSIAN_AUTH_SCOPES=read:me

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

REDIS_URL=
RUN_INLINE_JOBS=true

PUPPETEER_EXECUTABLE_PATH=
